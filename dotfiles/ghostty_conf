theme = Carbonfox
macos-option-as-alt = left
window-padding-color = background
window-padding-x = 10
window-padding-y = 0,10
window-padding-balance = true
font-size = 15
font-family = "JetBrainsMono Nerd Font Mono"
font-style = Light
adjust-cell-height = 8%

# Let Herdr handle workspace navigation.
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind

# Splits: navigate (vim-style)
keybind = cmd+opt+h=goto_split:left
keybind = cmd+opt+j=goto_split:down
keybind = cmd+opt+k=goto_split:up
keybind = cmd+opt+l=goto_split:right

# Splits: resize
keybind = cmd+ctrl+h=resize_split:left,40
keybind = cmd+ctrl+j=resize_split:down,40
keybind = cmd+ctrl+k=resize_split:up,40
keybind = cmd+ctrl+l=resize_split:right,40

# Splits: zoom + equalize
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits
