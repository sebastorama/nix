#!/usr/bin/env bash
# Nuke agent state for the WHOLE current tmux session: strip the state emoji
# from every window and from the session itself, then clear the visible terminal.

strip_emoji() {
  printf '%s' "$1" | sed -E 's/^(🔴|🟡|🟠|🟢|✅)[[:space:]]*//'
}

if [ -n "$TMUX" ] && [ -n "${TMUX_PANE:-}" ]; then
  session_id=$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null) || session_id=""

  if [ -n "$session_id" ]; then
    # Clear every window in the session.
    while IFS=$'\t' read -r win_id win_name; do
      base=$(strip_emoji "$win_name")
      [ "$base" != "$win_name" ] && tmux rename-window -t "$win_id" -- "$base" 2>/dev/null || true
    done < <(tmux list-windows -t "$session_id" -F '#{window_id}'$'\t''#W' 2>/dev/null)

    # Clear the session aggregate prefix.
    session_name=$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null) || session_name=""
    session_base=$(strip_emoji "$session_name")
    [ "$session_base" != "$session_name" ] && tmux rename-session -t "$session_id" -- "$session_base" 2>/dev/null || true
  fi
fi

clear
